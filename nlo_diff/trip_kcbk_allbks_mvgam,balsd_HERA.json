{
  "slurm": {
    "account": "lappi",
    "job-name": "trip_HERA",
    "partition": "gpumedium",
    "nodes": 1,
    "ntasks": 1,
    "time": "10:00:00",
    "cpus-per-task": 72,
    "gres": "gpu:gh200:1",
    "output": "slurm_%j.log",
    "max_concurrent_tasks": 10
  },
  "execution": {
    "interpreter": "python",
    "executable": "/projappl/lappi/abhiram/trip/kcbk_codes/sf_batched_nlo_sdaw_trip_T.py",
    "modules": [
      "python-tensorflow"
    ],
    "env_vars": {}
  },
  "experiment": {
    "result_database_path": "/scratch/lappi/abhiram/trip_database",
    "experiment_name": "kcbk_allbks_mvgam_balsd",
    "slrm_output_dir": "SLURM_OUTPUT",
    "tracking_args": {
         "save_dir": "{save_dir}_{__indicator}"
    }
  },
  "inner_loop": {
    "file_path": "/projappl/lappi/abhiram/trip/HERA_kinematic_points_smallx.txt",
    "delimiter": " ",
    "arg_names": ["--Q", "beta", "--x"]
  },
  "outer_loops": [
    {
      "type": "tabular_file",
      "file_path": "/projappl/lappi/abhiram/bayesian_alldata/KCBK_Balsd_MVgamma/posteriorsamples.dat",
      "delimiter": ",",
      "comment_prefix": "#",
      "skip_blank_lines": true,
      "args": [
        {
          "arg_name": "dipole_path",
          "column": 0,
          "template": "/projappl/lappi/abhiram/bayesian_alldata/KCBK_Balsd_MVgamma/bks/{val}.dat"
        },
        {
          "arg_name": "Csq",
          "column": 3
        }
      ]
    }
  ],
  "args": {
    "xmax": 160.0,
    "neval": 1e9
  }
}
